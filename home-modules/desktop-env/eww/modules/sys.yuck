(defwidget sys []
  (box
    :class "module"
    :space-evenly false
    :spacing 5
    (circular-progress
      :value "${EWW_CPU.avg}"
      :class "cpubar"
      :thickness 3
      (button
        :tooltip "using ${round(EWW_CPU.avg,0)}% cpu"
        :onclick "${EWW_CMD} open --toggle --screen 0 system-menu"
        (label :class "icon-text" :text "")))

    (circular-progress
      :value {memory.percentage}
      :class "membar"
      :thickness 3
      (button
        :tooltip "using ${round(memory.percentage,0)}% ram"
        :onclick "${EWW_CMD} open --toggle --screen 0 system-menu"
        (label :class "icon-text" :text "")))
    (box
      :spacing 5
      :visible {battery != "{}"}
    (circular-progress
      :value {battery_one != "{}" ? battery_one.percentage : 0}
      :class "batbar"
      :style "color: ${battery.color};"
      :thickness 3
      :visible {battery_one != {}}
      (button
        :tooltip {battery_one != "{}" ? "battery on ${battery_one.capacity}%": ""}
        :onclick "${EWW_CMD} open --toggle --screen 0 system-menu"
        (label :class "icon-text" :text "")))
    (circular-progress
      :value {battery != "{}" ? battery.percentage : 0}
      :class "batbar"
      :style "color: ${battery.color};"
      :thickness 3
      :visible {battery != {}}
      (button
        :tooltip {battery != "{}" ? "battery on ${battery_one.capacity}%": ""}
        :onclick "${EWW_CMD} open --toggle --screen 0 system-menu"
        (label :class "icon-text" :text ""))))
))
